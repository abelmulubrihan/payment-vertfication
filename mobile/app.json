{
  "expo": {
    "name": "PayVerify Ethiopia",
    "slug": "payverify-ethiopia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#022c22"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PayVerify Ethiopia to access camera to scan payment receipt QR codes."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.payverify.ethiopia",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#022c22"
      },
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
